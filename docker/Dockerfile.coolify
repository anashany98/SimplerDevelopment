# Coolify builds this image from Git; runtime must not depend on its checkout
# surviving in Coolify's temporary deployment directory.
#
# TWO runtimes in this image, on purpose:
# - Node.js runs the Next.js production build and `next start`. Next 16.3
#   production builds are fragile under Bun's runtime (CJS-wrapper crash
#   observed on Bun 1.3.11 — oven-sh/bun#25650, #25609), so the Next app uses
#   the Node runtime it is actually supported on. See the app command in
#   docker-compose.coolify.yml.
# - Bun (>= 1.3.14) stays the package manager (`bun install`), and runs the
#   Bun-native services (cron, realtime).
FROM node:22-slim AS nodejs
FROM oven/bun:1.3.14 AS source
# Node binary from the official image (same Debian base). `node --version`
# fails the image build early if the copied binary can't run here.
COPY --from=nodejs /usr/local/bin/node /usr/local/bin/node
RUN node --version
WORKDIR /workspace
COPY . .
RUN test -f package.json && test -f bun.lock \
    && test -f packages/realtime-server/package.json \
    && test -f scripts/cron-runner.ts

# The database init scripts also need to survive checkout cleanup.
FROM pgvector/pgvector:pg16 AS database
COPY docker/initdb/01-extensions.sql /docker-entrypoint-initdb.d/01-extensions.sql
